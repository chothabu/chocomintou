# 収集バッチは service_role キーで直接 DB に書く。サーバー上でだけ動かすこと。
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SERVICE_ROLE_KEY=

# 楽天ウェブサービスの資格情報。
# https://webservice.rakuten.co.jp/ で無料登録して発行する。
# アプリ ID とアクセスキーの両方が必要で、どちらか欠けると収集はスキップされる。
#
# アプリ登録時に Application type を「API/Backend Service」にすると、
# 実行元のグローバル IP を Allowed IP addresses に登録する必要がある。
# 現在の IP は `curl -s https://api.ipify.org` で確認できる。
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# 楽天アフィリエイト ID（任意）。設定すると商品リンクがアフィリエイト URL になる。
RAKUTEN_AFFILIATE_ID=
